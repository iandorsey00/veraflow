{
  "scopeName": "text.veraflow",
  "patterns": [
    {
      "include": "#header"
    },
    {
      "include": "#escape"
    },
    {
      "include": "#inlineWhen"
    },
    {
      "include": "#tag"
    },
    {
      "include": "#field"
    }
  ],
  "repository": {
    "header": {
      "begin": "\\A\\x{FEFF}?--- veraflow 2$",
      "end": "^---$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.metadata.veraflow"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.metadata.veraflow"
        }
      },
      "contentName": "meta.embedded.block.json",
      "patterns": [
        {
          "include": "source.json"
        }
      ]
    },
    "escape": {
      "match": "\\\\(?:\\\\|\\{\\{)",
      "name": "constant.character.escape.veraflow"
    },
    "tag": {
      "begin": "(\\{\\{)(#section|#when|/when|/section|else(?=\\}\\}))(?=[ \\t]|\\}\\})",
      "end": "(\\}\\})|$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.template.begin.veraflow"
        },
        "2": {
          "name": "keyword.control.veraflow"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.template.end.veraflow"
        }
      },
      "patterns": [
        {
          "include": "#quotedDouble"
        },
        {
          "include": "#quotedSingle"
        },
        {
          "match": "\\b(?:is not blank|is blank|else)(?=\\b)",
          "name": "keyword.control.veraflow"
        },
        {
          "match": "[=:]",
          "name": "keyword.operator.veraflow"
        },
        {
          "match": "[A-Za-z0-9_-]+",
          "name": "variable.other.veraflow"
        }
      ]
    },
    "field": {
      "match": "(\\{\\{)([^<>{}\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}]+)(\\}\\})",
      "captures": {
        "1": {
          "name": "punctuation.definition.template.begin.veraflow"
        },
        "2": {
          "name": "variable.other.veraflow"
        },
        "3": {
          "name": "punctuation.definition.template.end.veraflow"
        }
      }
    },
    "quotedDouble": {
      "name": "string.quoted.double.veraflow",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.veraflow"
        },
        {
          "include": "#field"
        }
      ]
    },
    "quotedSingle": {
      "name": "string.quoted.single.veraflow",
      "begin": "'",
      "end": "'|$",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.veraflow"
        },
        {
          "include": "#field"
        }
      ]
    },
    "inlineWhen": {
      "begin": "(\\{\\{)\\s*(when)(?=\\s)",
      "end": "(\\}\\})",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.template.begin.veraflow"
        },
        "2": {
          "name": "keyword.control.veraflow"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.template.end.veraflow"
        }
      },
      "patterns": [
        {
          "include": "#quotedDouble"
        },
        {
          "include": "#quotedSingle"
        },
        {
          "match": "\\b(?:is not blank|is blank|else)(?=\\b)",
          "name": "keyword.control.veraflow"
        },
        {
          "match": "[=:]",
          "name": "keyword.operator.veraflow"
        },
        {
          "match": "[A-Za-z0-9_-]+",
          "name": "variable.other.veraflow"
        }
      ]
    }
  }
}
